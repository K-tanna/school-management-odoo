<odoo>
<record id="view_student_promotion_wizard_form" model="ir.ui.view">
    <field name="name">student.promotion.wizard.form</field>
    <field name="model">student.promotion.wizard</field>
    <field name="arch" type="xml">
        <form string="Promote Student">
            <group>
                <field name="student_id"/>
                <field name="current_class_id"/>
                <field name="new_class_id"/>
            </group>

            <footer>
                <button string="Promote"
                        type="object"
                        name="action_promote_student"
                        class="btn-primary"/>
                <button string="Cancel"
                        class="btn-secondary"
                        special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>
